# Copier ce fichier en .env.local et renseigner les valeurs.

# Connexion PostgreSQL (via un pooler si disponible).
DATABASE_URL=postgres://utilisateur:motdepasse@hote/base

# Facultatif : connexion directe, utilisée pour les migrations.
DATABASE_URL_UNPOOLED=

# Secret de signature des sessions : une longue chaîne aléatoire.
# Exemple pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Adresse publique de l'appli, à renseigner en auto-hébergement
# (inutile en local et sur Vercel, où elle est déduite).
# BETTER_AUTH_URL=https://ubiboard.exemple.org

# Clé de chiffrement des secrets stockés en base (liens d'agenda) : 32 octets en base64.
# Elle doit être la même partout où la même base est utilisée.
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
