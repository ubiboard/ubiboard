{
  "name": "ubiboard",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "UbiBoard — hub familial open source, self-hosted, à écran d'accueil personnalisable par widgets.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "user:create": "node --env-file=.env.local --import tsx scripts/user.ts create",
    "user:password": "node --env-file=.env.local --import tsx scripts/user.ts password",
    "user:list": "node --env-file=.env.local --import tsx scripts/user.ts list"
  },
  "dependencies": {
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "next": "^15.0.0",
    "postgres": "^4.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
